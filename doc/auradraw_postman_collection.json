	"item": [
		{
			"name": "Auth (认证)",
			"item": [
				{
					"name": "发送验证码 (注册)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.code === 0 && jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"verify_token\", jsonData.data.token);",
									"    console.log(\"Verify Token set to environment variable\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"type\": \"register\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/send-code",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"send-code"
							]
						}
					},
					"response": []
				},
